# PostgreSQL
POSTGRES_DB=socialhub_auth
POSTGRES_USER=socialhub
POSTGRES_PASSWORD=local_auth_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT
JWT_ISSUER=SocialHub.AuthService
JWT_AUDIENCE=SocialHub.Client
JWT_SECRET=local-dev-jwt-secret-change-me-please-32-bytes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# Services
AUTH_SERVICE_PORT=8081
AUTH_GATEWAY_PORT=8080
