# PostgreSQL
POSTGRES_DB=socialhub_auth
POSTGRES_USER=socialhub
POSTGRES_PASSWORD=socialhub
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT
JWT_ISSUER=SocialHub.Auth
JWT_AUDIENCE=SocialHub
JWT_SECRET=dev-only-socialhub-auth-service-secret-32-bytes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# Services
AUTH_SERVICE_PORT=8081
AUTH_GATEWAY_PORT=8080
