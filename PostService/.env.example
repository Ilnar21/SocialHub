INTERNAL_SERVICE_TOKEN=development-internal-service-token
POST_SERVICE_PORT=8082

COMMUNITY_SERVICE_BASE_URL=http://community-service:8080
COMMUNITY_SERVICE_SKIP_MEMBERSHIP_CHECK=true

POSTGRES_HOST=postgres
POSTGRES_CONTAINER_PORT=5432
POSTGRES_PORT=5434
POSTGRES_DB=socialhub_posts
POSTGRES_USER=socialhub
POSTGRES_PASSWORD=socialhub

MINIO_HOST=minio
MINIO_API_PORT=9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=post-contents

# Short names are consumed by compose.yaml and also supported by the API.
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5434;Database=socialhub_posts;Username=socialhub;Password=socialhub
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Native ASP.NET configuration names also work when running the API directly.
ConnectionStrings__Postgres=Host=localhost;Port=5434;Database=socialhub_posts;Username=socialhub;Password=socialhub
Minio__Endpoint=http://localhost:9000
Minio__AccessKey=minioadmin
Minio__SecretKey=minioadmin
Minio__BucketName=post-contents
