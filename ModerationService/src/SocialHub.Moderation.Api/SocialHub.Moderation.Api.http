@host = http://localhost:5003
@ivan = 11111111-1111-1111-1111-111111111111
@userToken = paste-user-jwt-here
@moderatorToken = paste-platform-moderator-jwt-here
@post = 44444444-4444-4444-4444-444444444444

GET {{host}}/health

###

POST {{host}}/api/reports
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "targetType": "POST",
  "targetId": "{{post}}",
  "reason": "Спам",
  "comment": "Массовая реклама без смысла"
}

###

GET {{host}}/api/reports?status=NEW
Authorization: Bearer {{moderatorToken}}

###

POST {{host}}/api/users/{{ivan}}/blocks
Authorization: Bearer {{moderatorToken}}
Content-Type: application/json

{
  "durationDays": 7,
  "reason": "Повторный спам"
}
