{
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27019",
    "DatabaseName": "socialhub_notifications",
    "NotificationsCollection": "notifications",
    "EventsCollection": "notification_events"
  },
  "NotificationProcessing": {
    "PollingIntervalSeconds": 2,
    "MaxAttempts": 5
  },
  "NotificationRetention": {
    "NotificationDays": 90,
    "ReadNotificationDays": 30,
    "CompletedEventDays": 14,
    "FailedEventDays": 30
  },
  "ExternalServices": {
    "AuthBaseUrl": "",
    "TimeoutSeconds": 4
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "UserName": "",
    "Password": "",
    "FromEmail": "",
    "FromName": "SocialHub"
  },
  "Jwt": {
    "Issuer": "SocialHub.AuthService",
    "Audience": "SocialHub.Client",
    "Secret": "local-dev-jwt-secret-change-me-please-32-bytes"
  },
  "InternalAuth": {
    "RequireInternalToken": true,
    "Token": "local-dev-internal-service-token-change-me"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
