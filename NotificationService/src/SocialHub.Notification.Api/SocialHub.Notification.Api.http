@SocialHub.Notification.Api_HostAddress = http://localhost:5257
@UserId = 11111111-1111-1111-1111-111111111111
@token = paste-jwt-here

GET {{SocialHub.Notification.Api_HostAddress}}/api/notifications
Authorization: Bearer {{token}}
Accept: application/json

###

POST {{SocialHub.Notification.Api_HostAddress}}/api/notifications/internal
Content-Type: application/json

{
  "recipientUserId": "{{UserId}}",
  "type": "MessageReceived",
  "title": "New message",
  "message": "You received a new message",
  "sourceService": "MessageService"
}

###

POST {{SocialHub.Notification.Api_HostAddress}}/api/notification-events
Content-Type: application/json

{
  "recipientUserId": "{{UserId}}",
  "type": "SuggestedPostApproved",
  "title": "Suggested post approved",
  "message": "Your suggested post was approved",
  "sourceService": "CommunityService",
  "sourceEntityId": "22222222-2222-2222-2222-222222222222"
}
