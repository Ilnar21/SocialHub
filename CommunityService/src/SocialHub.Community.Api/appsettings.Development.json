{
  "ConnectionStrings": {
    "CommunityDatabase": "Host=localhost;Port=5433;Database=socialhub_community;Username=socialhub;Password=socialhub_password"
  },
  "ExternalServices": {
    "NotificationBaseUrl": "",
    "PostBaseUrl": "",
    "TimeoutSeconds": 4
  },
  "ApplyMigrationsOnStartup": false,
  "Jwt": {
    "Issuer": "SocialHub.AuthService",
    "Audience": "SocialHub.Client",
    "Secret": "development-secret-key-for-socialhub-integration"
  },
  "DevAuth": {
    "EnableHeaderFallback": true
  },
  "InternalAuth": {
    "RequireInternalToken": true,
    "Token": "development-internal-service-token"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
