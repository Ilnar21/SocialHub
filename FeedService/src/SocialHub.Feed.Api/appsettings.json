{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cache": {
    "ConnectionString": "localhost:6379",
    "TtlSeconds": 300,
    "KeyPrefix": "feed"
  },
  "Services": {
    "CommunityServiceUrl": "http://community-service:8080",
    "PostServiceUrl": "http://post-service:8080",
    "TimeoutSeconds": 4
  },
  "Jwt": {
    "Issuer": "SocialHub.AuthService",
    "Audience": "SocialHub.Client",
    "Secret": "local-dev-jwt-secret-change-me-please-32-bytes"
  },
  "DevAuth": {
    "EnableHeaderFallback": false
  }
}
