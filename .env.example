# Shared security settings
JWT_ISSUER=SocialHub.AuthService
JWT_AUDIENCE=SocialHub.Client
JWT_SECRET=local-dev-jwt-secret-change-me-please-32-bytes
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
INTERNAL_SERVICE_TOKEN=local-dev-internal-service-token-change-me
INTERNAL_AUTH_REQUIRE_TOKEN=true
DEV_AUTH_ENABLE_HEADER_FALLBACK=false

# PostgreSQL credentials
AUTH_POSTGRES_DB=socialhub_auth
AUTH_POSTGRES_USER=socialhub
AUTH_POSTGRES_PASSWORD=local_auth_password
COMMUNITY_POSTGRES_DB=socialhub_community
COMMUNITY_POSTGRES_USER=socialhub
COMMUNITY_POSTGRES_PASSWORD=local_community_password
MODERATION_POSTGRES_DB=socialhub_moderation
MODERATION_POSTGRES_USER=socialhub
MODERATION_POSTGRES_PASSWORD=local_moderation_password
POST_POSTGRES_DB=socialhub_posts
POST_POSTGRES_USER=socialhub
POST_POSTGRES_PASSWORD=local_post_password

# Post object storage
POST_MINIO_ROOT_USER=local_minio_user
POST_MINIO_ROOT_PASSWORD=local_minio_password
POST_MINIO_BUCKET=post-contents
POST_MINIO_PORT=9000
POST_MINIO_CONSOLE_PORT=9001

# SMTP. Use a Google app password here in local .env, never a Gmail account password.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_START_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=SocialHub

# Runtime tuning
EXTERNAL_SERVICE_TIMEOUT_SECONDS=4
