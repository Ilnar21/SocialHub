@page "/Profile"
@{
    ViewData["Title"] = "Профиль";
}

<header class="page-header">
    <div>
        <h1>Профиль</h1>
        <p>Личный кабинет и данные текущей сессии.</p>
    </div>
    <button class="button secondary" data-reload-me>Обновить</button>
</header>

<section class="split">
    <form class="panel form-grid" data-form="update-profile">
        <h2>Данные профиля</h2>
        <label>Имя<input name="displayName" data-profile-display-name /></label>
        <label>Описание<textarea name="bio" data-profile-bio></textarea></label>
        <label>Avatar URL<input name="avatarUrl" data-profile-avatar /></label>
        <button class="button primary" type="submit">Сохранить</button>
    </form>
    <div class="panel profile-summary" data-profile-summary></div>
</section>

@section Scripts {
    <script type="module" src="~/js/pages/profile.js" asp-append-version="true"></script>
}
