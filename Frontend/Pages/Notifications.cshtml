@page "/Notifications"
@{
    ViewData["Title"] = "Уведомления";
}

<header class="page-header">
    <div>
        <h1>Уведомления</h1>
        <p>События публикаций, модерации и личных сообщений. Новые уведомления подсвечены акцентным цветом.</p>
    </div>
    <button class="button secondary subtle-action" data-load-notifications>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 4 23 10 17 10" />
            <polyline points="1 20 1 14 7 14" />
            <path d="M3.5 9a9 9 0 0 1 15-3.4L23 10" />
            <path d="M20.5 15a9 9 0 0 1-15 3.4L1 14" />
        </svg>
        Обновить
    </button>
</header>

<form class="panel notification-filters" data-notification-filters>
    <label>Тип
        <select name="type" data-notification-type>
            <option value="all">Все уведомления</option>
            <option value="messages">Сообщения</option>
            <option value="joinRequests">Заявки на вступление</option>
            <option value="suggestedPosts">Предложенные посты</option>
            <option value="moderation">Модерация платформы</option>
        </select>
    </label>
    <label>Период
        <select name="period" data-notification-period>
            <option value="all">За все время</option>
            <option value="day">За день</option>
            <option value="week">За неделю</option>
            <option value="year">За год</option>
        </select>
    </label>
    <span class="feed-toolbar-status" data-notification-status></span>
</form>

<section class="content-list" data-notifications-list></section>

@section Scripts {
    <script type="module" src="~/js/pages/notifications.js" asp-append-version="true"></script>
}
