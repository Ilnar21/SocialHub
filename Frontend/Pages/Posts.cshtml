@page "/Posts"
@{
    ViewData["Title"] = "Посты";
}

<header class="page-header">
    <div>
        <h1>Посты</h1>
        <p>Публикации существуют только внутри сообществ. Дневной лимит — до 100 постов в одно сообщество.</p>
    </div>
    <button class="button secondary subtle-action" data-load-posts>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 4 23 10 17 10" />
            <polyline points="1 20 1 14 7 14" />
            <path d="M3.5 9a9 9 0 0 1 15-3.4L23 10" />
            <path d="M20.5 15a9 9 0 0 1-15 3.4L1 14" />
        </svg>
        Обновить
    </button>
</header>

<section class="split">
    <form class="panel form-grid" data-form="create-post">
        <h2>Новая публикация</h2>
        <label>Сообщество
            <select name="communityId" data-community-select required></select>
        </label>
        <label>Заголовок
            <input name="title" maxlength="120" placeholder="Паттерны интеграции" required />
        </label>
        <label>Текст поста
            <textarea name="text" maxlength="10000" placeholder="Поделитесь мыслью, ссылкой или вопросом — но один пост на одну идею." required></textarea>
        </label>
        <label>Фото
            <input name="media" type="file" accept="image/*" multiple data-post-media />
        </label>

        <div class="meta" style="margin-top:0;">
            <span>Правило BR-1: посты доступны только в сообществах</span>
            <span>BR-2: до 100 постов / сутки / сообщество</span>
        </div>

        <button class="button primary" type="submit" data-submit-post>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="22" y1="2" x2="11" y2="13" />
                <polygon points="22 2 15 22 11 13 2 9 22 2" />
            </svg>
            Опубликовать
        </button>
        <p class="muted" data-post-form-hint></p>
    </form>

    <div class="stack">
        <div class="content-list" data-posts-list></div>
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/pages/posts.js" asp-append-version="true"></script>
}
