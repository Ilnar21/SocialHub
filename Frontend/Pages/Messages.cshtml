@page "/Messages"
@{
    ViewData["Title"] = "Сообщения";
}

<header class="page-header">
    <div>
        <h1>Сообщения</h1>
        <p>Личные диалоги, изолированные от модерации платформы. Доступны только участникам переписки.</p>
    </div>
    <button class="button secondary subtle-action" data-load-dialogs>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 4 23 10 17 10" />
            <polyline points="1 20 1 14 7 14" />
            <path d="M3.5 9a9 9 0 0 1 15-3.4L23 10" />
            <path d="M20.5 15a9 9 0 0 1-15 3.4L1 14" />
        </svg>
        Обновить
    </button>
</header>

<section class="split">
    <div class="stack">
        <form class="panel form-grid" data-form="send-message">
            <h2>Написать</h2>
            <label>Получатель
                <select name="recipientUserId" data-user-select></select>
            </label>
            <label>Текст сообщения
                <textarea name="text" maxlength="4000" placeholder="Не более 4000 символов" required></textarea>
            </label>
            <button class="button primary" type="submit">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="22" y1="2" x2="11" y2="13" />
                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                </svg>
                Отправить
            </button>
        </form>

        <div class="panel">
            <h2>Диалоги</h2>
            <div class="content-list" data-dialogs-list></div>
        </div>
    </div>

    <div class="panel">
        <h2>История переписки</h2>
        <div class="messages" data-messages-list></div>
    </div>
</section>

@section Scripts {
    <script type="module" src="~/js/pages/messages.js" asp-append-version="true"></script>
}
