@page "/Messages"
@{
    ViewData["Title"] = "Сообщения";
}

<header class="page-header">
    <div>
        <h1>Сообщения</h1>
        <p>Личные диалоги создаются только после первого отправленного сообщения.</p>
    </div>
    <button class="button secondary subtle-action" data-load-dialogs>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 4 23 10 17 10" />
            <polyline points="1 20 1 14 7 14" />
            <path d="M3.5 9a9 9 0 0 1 15-3.4L23 10" />
            <path d="M20.5 15a9 9 0 0 1-15 3.4L1 14" />
        </svg>
        Обновить
    </button>
</header>

<section class="telegram-shell">
    <aside class="panel telegram-sidebar">
        <form class="telegram-search" data-form="open-recipient">
            <label>Поиск собеседника по username
                <input name="recipientUsername" data-recipient-search placeholder="@@username" autocomplete="off" />
            </label>
            <button class="button primary" type="submit">Открыть</button>
        </form>

        <div class="telegram-dialogs" data-dialogs-list></div>
    </aside>

    <section class="panel telegram-chat">
        <div class="telegram-chat-header">
            <div>
                <h2 data-active-chat-title>Выберите диалог</h2>
                <p data-active-chat-subtitle>Или введите username сверху, чтобы открыть пустой чат.</p>
            </div>
        </div>

        <div class="messages telegram-messages" data-messages-list></div>

        <form class="message-composer" data-form="send-message">
            <textarea name="text" maxlength="4000" placeholder="Сообщение" required disabled></textarea>
            <button class="button primary" type="submit" disabled>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="22" y1="2" x2="11" y2="13" />
                    <polygon points="22 2 15 22 11 13 2 9 22 2" />
                </svg>
                Отправить
            </button>
        </form>
    </section>
</section>

@section Scripts {
    <script type="module" src="~/js/pages/messages.js" asp-append-version="true"></script>
}
