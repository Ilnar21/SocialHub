@page "/Communities"
@{
    ViewData["Title"] = "Сообщества";
}

<header class="page-header">
    <div>
        <h1>Сообщества</h1>
        <p>Создавайте сообщества, вступайте в них и сразу переходите к публикациям.</p>
    </div>
    <button class="button secondary subtle-action" data-load-communities>Синхронизировать</button>
</header>

<section class="split">
    <form class="panel form-grid" data-form="create-community">
        <h2>Новое сообщество</h2>
        <label>Название<input name="name" placeholder="backend_daily" required /></label>
        <label>Описание<textarea name="description" required></textarea></label>
        <label>Тип
            <select name="type">
                <option value="Open">Открытое</option>
                <option value="Closed">Закрытое</option>
            </select>
        </label>
        <button class="button primary" type="submit">Создать</button>
    </form>
    <div class="content-list" data-communities-list></div>
</section>

@section Scripts {
    <script type="module" src="~/js/pages/communities.js" asp-append-version="true"></script>
}
