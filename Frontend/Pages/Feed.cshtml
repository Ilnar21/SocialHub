@page "/Feed"
@{
    ViewData["Title"] = "Лента";
}

<header class="page-header">
    <div>
        <h1>Лента</h1>
        <p>Публикации из ваших сообществ. Кликните на карточку, чтобы открыть пост, комментарии и метаданные.</p>
    </div>
    <button class="button secondary subtle-action" data-refresh-feed>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 4 23 10 17 10" />
            <polyline points="1 20 1 14 7 14" />
            <path d="M3.5 9a9 9 0 0 1 15-3.4L23 10" />
            <path d="M20.5 15a9 9 0 0 1-15 3.4L1 14" />
        </svg>
        Синхронизировать
    </button>
</header>

<section class="feed-layout">
    <div class="content-list" data-feed-list></div>
    <aside class="panel post-detail-panel" data-post-detail>
        <div class="empty">
            <h2>Выберите пост</h2>
            <p>Подробности, комментарии и действия появятся здесь.</p>
        </div>
    </aside>
</section>

@section Scripts {
    <script type="module" src="~/js/pages/feed.js" asp-append-version="true"></script>
}
