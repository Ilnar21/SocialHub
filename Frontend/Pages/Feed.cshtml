@page "/Feed"
@{
    ViewData["Title"] = "Лента";
}

<header class="page-header">
    <div>
        <h1>Лента</h1>
        <p>Публикации из ваших сообществ, отсортированные по популярности. Откройте пост, чтобы увидеть детали, комментарии и форму жалобы.</p>
    </div>
    <button class="button secondary subtle-action" data-refresh-feed>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="23 4 23 10 17 10" />
            <polyline points="1 20 1 14 7 14" />
            <path d="M3.5 9a9 9 0 0 1 15-3.4L23 10" />
            <path d="M20.5 15a9 9 0 0 1-15 3.4L1 14" />
        </svg>
        Синхронизировать
    </button>
</header>

<section class="feed-layout">
    <form class="feed-toolbar panel" data-feed-filters>
        <label>
            Сортировка
            <select data-feed-sort>
                <option value="popular">Популярные</option>
                <option value="newest">Новые</option>
                <option value="discussed">Обсуждаемые</option>
            </select>
        </label>
        <label>
            Период
            <select data-feed-period>
                <option value="all">Все время</option>
                <option value="day">За день</option>
                <option value="week">За неделю</option>
                <option value="month">За месяц</option>
                <option value="year">За год</option>
            </select>
        </label>
        <span class="feed-toolbar-status" data-feed-status></span>
    </form>
    <div class="content-list" data-feed-list></div>
</section>

@section Scripts {
    <script type="module" src="~/js/pages/feed.js" asp-append-version="true"></script>
}
